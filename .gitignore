# Files
.env
.DS_Store
*test.*
package-lock.json

# Folders
node_modules/
.codacy/

# AI
.github/instructions/codacy.instructions.md
.claude/
plan.md
CLAUDE.md
GEMINI.md
doc/

# Added by ggshield
.cache_ggshield

# Temp
.hasrc

# Machine-local (installed or written per machine)
config/zsh/oh-my-zsh/
config/git/local.gitconfig

# App data adopted by mistake: caches, sessions, tokens. Never commit.
config/Claude/

# espanso matches with personal and work contact details (local only)
config/espanso/match/private.yml

# Each machine's dotfiles config (~/.config/dotfiles/config.yml). It used to
# be a link into this folder; never commit one written through it.
config/dotfiles/config.yml

# gh login state, written per machine by gh auth login (token lives in the keyring)
config/gh/hosts.yml

# Python bytecode cache
__pycache__/

# Third-party Omarchy themes: separate git repos, cloned in place. Re-clone with:
#   git clone <url> config/omarchy/themes/<name>
# https://github.com/bjarneo/omarchy-futurism-theme
config/omarchy/themes/futurism/
# https://github.com/archer-clawbot/omarchy-hermarchy-theme
config/omarchy/themes/hermarchy/
# https://github.com/devgtv/omarchy-japan-night-theme
config/omarchy/themes/japan-night/

# Aether: generated theme output (rebuilt on every apply) and the
# Wallhaven API key
config/aether/theme/
config/aether/wallhaven.json
config/aether/*.pid
config/aether/*.sock

# zsh completion cache, regenerated by compinit (ZDOTDIR is config/zsh)
.zcompdump*
config/zsh/oh-my-zsh/
config/superfile/theme/
config/composer/auth.json
config/composer/vendor/
config/composer/composer.lock
config/composer/.htaccess
config/cspell/node_modules/

# bat: the current theme, installed by the omarchy theme-set hook (generated)
config/bat/themes/omarchy.tmTheme
