# !------------------------------------
# @@@ SHELL
# !------------------------------------
if [[ -n "$ZSH_VERSION" ]]
then
	alias reload='source "${ZDOTDIR:-$HOME}/.zshrc"'
else
	alias reload="source ~/.bashrc"
fi

alias c="clear"
alias cl="clear"
alias fenv="source ~/.zshenv"
alias fresh="source $ZDOTDIR/.zshrc; clear"
alias aliasUpdate="fresh 2>&1 && c"
alias histg="history | fzf"
alias findAlias="alias | fzf"


# !------------------------------------
# @@@ CODING AGENTS
# !------------------------------------
alias cc='claude'
alias cx='codex'
alias co='copilot'
alias hm='hermes'
alias oc='opencode'
alias a="omarchy-agent --inline"
alias ic='tdl c'
alias icx='tdl c cx'
alias ix='tdl cx'


# !------------------------------------
# @@@ FILE EDITS
# !------------------------------------
# alias edit="$EDITOR"   # replaced by the edit() function in .functions
alias ea="$EDITOR $DOTFILES/config/zsh/.aliases"
alias ef="$EDITOR $DOTFILES/config/zsh/.functions"
alias ee="$EDITOR $DOTFILES/config/zsh/.zshenv"
alias base="$EDITOR ~/Library/CloudStorage/OneDrive-Personal/Documents/Espanso/match/base.yml"
alias netcfg="sudo $EDITOR /etc/netplan/50-cloud-init.yaml"
alias cloudcfg="sudo $EDITOR /etc/cloud/cloud.cfg"


# !------------------------------------
# @@@ FILES
# !------------------------------------
alias ls="eza --icons --group-directories-last"
alias ll="ls -lh"
alias la="ls -lah"
alias lt="ls --tree"
alias rm="rm -i"
alias xbin="chmod +x ~/bin/*"
alias decompress='tar -xzf'
alias ff='fzf --preview '\''bat --style=numbers --color=always {}'\'''
alias eff='$EDITOR "$(ff)"'


# !------------------------------------
# @@@ GIT
# !------------------------------------
alias gs="git status"
alias gss="git status -s"
alias gsb="git status -bs"
alias gc="git clone"
alias gi="git init"
alias gcm="git commit -m"
alias gam="git commit --amend --no-edit"
alias ga="git add"
alias gaa="git add ."
alias gp="git push"
alias gpu="git push -u origin main"
alias gpl="git pull"
alias gco="git checkout -b"
alias gsw="git switch"
alias save="gaa && gcm \"chore: save point\""
alias incom="gaa && gcm \"initial commit\""
alias cached="git rm -r --cached"


# !------------------------------------
# @@@ GOTCHAS
# !------------------------------------
alias get="git"
alias got="git"
alias sudp="sudo"


# !------------------------------------
# @@@ NAVIGATION
# !------------------------------------
alias cd='zd'
alias dots="cd $DOTFILES"
alias github="cd $GITHUB_DIR"
alias sshd="cd /etc/ssh"


# !------------------------------------
# @@@ NETWORKING
# !------------------------------------
alias pubip="curl http://ipecho.net/plain; echo"
alias locip='ip -4 addr show eth0 | grep -oP "(?<=inet\s)\d+(\.\d+){3}"'
alias ping="ping -c3"
alias sshcopy="ssh-copy-id -i ~/.ssh/id_ed25519.pub -p 22"


# !------------------------------------
# @@@ NPM
# !------------------------------------
alias toi="npm init --scope=@taste-ink --init-author-email=23495830+PaleBluDot@users.noreply.github.com -y"
alias npmi="npm init"
alias npmiy="npm init -y"
alias npmb="npm run build"
alias npmd="npm run dev"
alias npms="npm run start"
alias npmc="npm run commit"
alias clean-node="rm -rf ./node_modules && rm -rf package-lock.json"


# !------------------------------------
# @@@ PACKAGES
# !------------------------------------
alias rmdpkg="sudo apt-get --purge remove"
alias brew-installs="brew list > ~/.config/brew.txt"
alias mup='MISE_MINIMUM_RELEASE_AGE=0 mise up'


# !------------------------------------
# @@@ SHORTCUTS
# !------------------------------------
alias h="herdr"
alias d="docker"
alias g="git"
alias r="rails"


# !------------------------------------
# @@@ TMUX
# !------------------------------------
alias tm="tmux attach -t main || tmux new -s main"
alias tn="tmux new -s"
alias ta="tmux attach -t"
alias td="tmux detach"
alias tl="tmux ls"
alias tk="tmux kill-session -t"
alias tka="tmux kill-server"
alias trn="tmux rename-session -t"
alias ts="tmux switch-client -t"


# !------------------------------------
# @@@ TOOLS
# !------------------------------------
alias gd="gobuster -w ~/.config/gobuster.txt"
alias comlist="cat test.html | tr "\n" "," > comma-list.txt"
alias wget="wget --no-hsts"


# !------------------------------------
# @@@ USERS & GROUPS
# !------------------------------------
alias adduser="sudo adduser"
alias deluser="sudo deluser --remove-home"
alias addgroup="sudo usermod -aG"
alias delgroup="sudo usermod -G"
alias group="cat /etc/group"


# !------------------------------------
# @@@ VS CODE
# !------------------------------------
alias code="code-insiders"
alias teach="code --extensions-dir ~/code_profiles/teach/exts --user-data-dir ~/code_profiles/teach/data"
