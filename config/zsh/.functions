# mkprj — create a new project folder under ~/github/<org>/ and open it.
#
# Lists the folders inside ~/github (your user and orgs), asks you to pick
# one, asks for a project name, then creates the folder, cd's into it,
# runs `git init`, and opens it with `code-insiders .`.
#
# Usage:
#   mkprj
#
# Requires: ~/github with one folder per user/org, and `code-insiders` on PATH.
##! Need to add git init and gh creation.
function mkprj() {
	echo "Selected org:"
	select org in $(exec ls ~/github)

	do
		echo "You selected $org"
		echo "Name of the project?"
		read project
		mkdir -p ~/github/$org/$project
		cd ~/github/$org/$project
		git init
		code-insiders .
		echo "Project created in ~/github/$org/$project"
		break;
	done
}

# husky — create a Husky git hook script in the current repo.
#
# Runs `npx husky add .husky/<hook> "<command>"`, which writes a hook file
# that runs <command> when the git hook fires.
#
# Usage:
#   husky <hook-name> "<command>"
#
# Example:
#   husky pre-commit "npm test"
#
# Run it from the root of a repo that already has Husky set up.
##! Need to add a check if already exist.
function husky() {
	echo "\n⏳ Creating…\n"
	npx husky add .husky/"$1" "$2" # Local delete.
	echo "\n✅ Husky script has been created.\n"
}

# loIP — print the local IP address of this machine.
#
# Uses `ip` if it is installed, otherwise falls back to `ifconfig`. In both
# cases it prints the second field of every line containing "broadcast".
#
# Usage:
#   loIP
function loIP() {
	ip=

	if command -v ip &> /dev/null
	then
		echo "Using <ip>"
		ip=$(ip add | grep "broadcast" | awk '{print $2}')
		echo "$ip"
		return
	fi

	echo "Using <ifconfig>"
	ip=$(ifconfig | grep "broadcast" | awk '{print $2}')
	echo "$ip"

	# if [[ ! -z "$ip" ]]; then
	# 		echo "$ip"
	# fi
}

# getWebsiteIP — look up the IP address of one or more hostnames.
#
# Runs `dscacheutil -q host -a name <host>` for each argument and prints the
# full record it returns. macOS only (dscacheutil does not exist on Linux).
#
# Usage:
#   getWebsiteIP <host> [host...]
#   getWebsiteIP hosts <host> [host...]   # a leading "hosts" is ignored
#
# Example:
#   getWebsiteIP example.com
function getWebsiteIP() {
  [ "$1" = "hosts" ] && shift
  for x
  do
    # echo $(dscacheutil -q host -a name $x | awk '/^ip_address/{print $NF}')
    dscacheutil -q host -a name $x
  done
}

# gobust — run gobuster against a site using your wordlist.
#
# Mode "dns" runs `gobuster dns -d <url>`. Any other mode runs
# `gobuster -d https://<url>`. The wordlist is ~/.config/gobuster.txt.
#
# Usage:
#   gobust <mode> <url>
#
# Example:
#   gobust dns example.com
#
# Requires: gobuster on PATH and the wordlist file above.
# Only use this on sites you own or have permission to test.
function gobust() {
	MODE=$1
	URL=$2
	WORDLIST=~/.config/gobuster.txt

	if [ -z $URL ]
	then
		echo "Error: no URL provided"
	fi

	if [ $MODE = "dns" ] 2&> /dev/null
	then
		# echo "Using mode: $MODE"
		gobuster $MODE -d $URL -w "$WORDLIST"
	else
		# echo "Using mode: dir"
		gobuster -d "https://$URL" -w "$WORDLIST"
	fi
}

# pushover — send a notification to the Pushover platform.
#
# Intended for sending script error messages to your phone. The message is
# sent as HTML, prefixed with the hostname and followed by the current user
# and a "View" link.
#
# Usage:
#   pushover <message> [title] [priority] [url]
#
# Arguments (positional, in this order):
#   message   Required. Text to send.
#   title     Optional. Defaults to user@hostname.
#   priority  Optional. Defaults to 0.
#   url       Optional. Defaults to https://example.com/.
#
# Example:
#   pushover "Backup finished" "Backup" 0
#
# Notes: with no arguments it prints the usage line and calls `exit 1`,
# which closes your shell (or detaches tmux, see the exit override below).
function pushover() {
	APP_TOKEN="azgrm981bxopyyxd74b7qbrisxxfjx"
	USER_TOKEN="g4yhnf9391i3wgpgkvi7scruipy2g7"
	MESSAGE=$1
	TITLE=$2
	PRIORITY=$3
	URL=$4
	USER=$(whoami)
	HOSTNAME=$(uname -n)

	if [ $# -eq 0 ]; then
		echo "Usage: pushover <message> [title] <priority> [url]"
		exit 1
	fi

	if [ $# -lt 2 ]; then
		TITLE="$USER@$HOSTNAME"
		PRIORITY="0"
		URL="https://example.com/"
	fi

	if [ $# -lt 3 ]; then
		PRIORITY="0"
		URL="https://example.com/"
	fi

	curl -s \
  --form-string "token=$APP_TOKEN" \
  --form-string "user=$USER_TOKEN" \
  --form-string "html=1" \
  --form-string "priority=$PRIORITY" \
  --form-string "retry=60" \
  --form-string "expire=3600" \
  --form-string "title=$TITLE" \
  --form-string "message=<b>$HOSTNAME:</b> $MESSAGE! <i>From user: $USER</i> <a href=\"$URL\"><b>View</b></a>" \
  https://api.pushover.net/1/messages.json
}

# dotfiles-update — pull the latest dotfiles and re-apply them.
#
# If $DOTFILES is not set it defaults to $HOME/.config/dotfiles. Then it
# cd's there, checks out main, runs `git pull`, runs `fresh`, and finally
# cd's to $HOME (it does not return you to where you started).
#
# Usage:
#   dotfiles-update
#
# Requires: the `fresh` dotfiles manager on PATH.
function dotfiles-update() {
	if [[ -z "${DOTFILES}" ]]; then
		echo "Does not Exits. Creating dotfiles."
		export DOTFILES="$HOME/.config/dotfiles"
	fi

	clear
	cd $DOTFILES
	git checkout main
	git pull
	clear
	fresh
	cd $HOME
}

# checkGit — report whether the current git repo has uncommitted changes.
#
# Counts the lines of `git status --porcelain` and prints a green line when
# there are 0 changes or a red line with the count otherwise. It always
# returns 0, so read the output rather than the exit status.
#
# Usage:
#   checkGit        # run inside a git repo
#
# Requires: the color variables LIGHTGREEN, LIGHTRED and NC to be defined.
function checkGit() {
	COUNT=$(git status --porcelain | wc -l)

	if [ $COUNT -eq "0" ]; then
		echo "  🟢${LIGHTGREEN}$COUNT changes!${NC} Git repo is clean."
	else
		echo "  🔴${LIGHTRED}$COUNT changes!${NC} Git repo dirty."
		return
	fi
}

# checkAllRepos — report the state of every repo under a root folder.
#
# Walks <root>/<org>/<repo> two levels deep, cd's into each repo, and
# reports both uncommitted changes (via checkGit) and commits that are ahead
# of the pushed upstream branch. Repos with no upstream branch get a warning.
#
# Usage:
#   checkAllRepos              # scans the default root (set on the `root=` line)
#   checkAllRepos ~/some/path  # scans a different root
#
# Requires: zsh (uses zsh glob qualifiers), checkGit, and the LIGHTRED / NC
# color variables.
function checkAllRepos() {
	local root="${1:-/Users/psanchez/Documents/github.com}"

	if [[ ! -d "$root" ]]; then
		echo "Directory not found: $root"
		return 1
	fi

	# org/repo = two levels of directories.
	# (/N) qualifier: / = dirs only, N = don't error if nothing matches.
	for org_dir in "$root"/*(/N); do
		for repo_dir in "$org_dir"/*(/N); do
			[[ -d "$repo_dir/.git" ]] || continue

			local repo_label="${org_dir:t}/${repo_dir:t}"

			# checkGit reads git status in the current directory, so
			# subshell + cd keeps us from having to cd back afterward.
			(
				cd "$repo_dir" || exit
				echo "${repo_label}:"
				checkGit

				# Commits made locally but never pushed to upstream.
				local unpushed
				unpushed=$(git log '@{u}..HEAD' --oneline 2>/dev/null)
				local upstream_exit=$?

				if [[ $upstream_exit -ne 0 ]]; then
					echo "  ⚠️ ${LIGHTRED}No upstream branch set${NC}"
				elif [[ -n "$unpushed" ]]; then
					local count=$(echo "$unpushed" | wc -l | tr -d ' ')
					echo "  ⬆️ ${LIGHTRED}$count unpushed commit(s)${NC}"
				fi
			)
		done
	done
}

# checkAllReposQuiet — same repo walk as checkAllRepos, but silent unless
# something needs attention.
#
# Prints one line per repo that has uncommitted changes, unpushed commits,
# or no upstream branch, and prints nothing for clean repos. Designed to be
# captured and conditionally printed from .zshrc, not called directly.
#
# Usage:
#   checkAllReposQuiet [root]     # root defaults to the path on the `root=` line
#
# Example (in .zshrc):
#   out=$(checkAllReposQuiet); [[ -n "$out" ]] && echo "$out"
#
# Requires: zsh and the LIGHTRED / NC color variables.
function checkAllReposQuiet() {
	local root="${1:-/Users/psanchez/Documents/github.com}"
	[[ -d "$root" ]] || return

	for org_dir in "$root"/*(/N); do
		for repo_dir in "$org_dir"/*(/N); do
			[[ -d "$repo_dir/.git" ]] || continue

			(
				cd "$repo_dir" || exit

				local repo_label="${org_dir:t}/${repo_dir:t}"

				local dirty_count
				dirty_count=$(git status --porcelain 2>/dev/null | wc -l | tr -d ' ')

				local unpushed
				unpushed=$(git log '@{u}..HEAD' --oneline 2>/dev/null)
				local upstream_exit=$?

				if [[ "$dirty_count" -gt 0 ]]; then
					echo "  🔴 ${LIGHTRED}${repo_label}: ${dirty_count} uncommitted change(s)${NC}"
				fi

				if [[ $upstream_exit -eq 0 && -n "$unpushed" ]]; then
					local ahead_count
					ahead_count=$(echo "$unpushed" | wc -l | tr -d ' ')
					echo "  ⬆️ ${LIGHTRED}${repo_label}: ${ahead_count} unpushed commit(s)${NC}"
				elif [[ $upstream_exit -ne 0 ]]; then
					echo "  ⚠️ ${LIGHTRED}${repo_label}: no upstream branch set${NC}"
				fi
			)
		done
	done
}

# getHTTPCode — print the HTTP status code of a URL.
#
# Uses curl to fetch the status code and prints "Status Code: <code>".
# The code is printed whether or not it is 200.
#
# Usage:
#   getHTTPCode <url>
#
# Example:
#   getHTTPCode https://example.com
#
# Note: on a 200 response it calls `exit 0`, which closes your shell (or
# detaches tmux, see the exit override below) when run interactively.
function getHTTPCode() {
	local url=$1
	status_code=$(curl --write-out "%{http_code}\n" --silent --output /dev/null "$url");

  if [[ "$status_code" -ne 200 ]] ; then
    echo "Status Code: $status_code"
  else
		echo "Status Code: $status_code"
    exit 0
  fi
}

# add_flags — turn a word list into CSpell "forbidden word" entries.
#
# Reads a file with one word per line. For each word it writes three
# entries, each with a leading "!": the word as written, lowercase, and
# uppercase. CSpell flags a "!word" entry as an error wherever it appears.
# The output file is overwritten on every run.
#
# Usage:
#   add_flags <word-list-file>
#
# Output: the OUTPUTFILE path set inside the function, under $GITHUB_DIR.
# Requires: the GITHUB_DIR environment variable.
function add_flags() {
	local FILE=$1
	local FLAG=\!
	local OUTPUTFILE=${GITHUB_DIR}/PaleBluDot/aclu-emails/.config/dictionaries/flags.txt

	cat $FILE | while read LINE; do \
		CAPITALIZED=`echo "${LINE}" | tr '[a-z]' '[A-Z]'`
		LOWERCASE=`echo "${LINE}" | tr '[A-Z]' '[a-z]'`

		echo ${FLAG}${LINE};\
		echo ${FLAG}${LOWERCASE};\
		echo ${FLAG}${CAPITALIZED};\
	done | \
	> $OUTPUTFILE
}


# delete — delete a git branch locally and on the remote.
#
# Runs `git branch -D <branch>` (force delete, even if unmerged) and then
# `git push origin --delete <branch>`. With no argument it prints a reminder
# instead of deleting anything.
#
# Usage:
#   delete <branch-name>
#
# Example:
#   delete feature/old-idea
#
# Run it inside the repo. Git will refuse to delete the branch you are
# currently on.
##! Need to add a check to see if
##! branch is removed on remote.
function delete {
	# Branch name present?
	if [[ -z "$1" ]]; then
			echo "\n ~T Oops… you forgot to provide the branch name"
			echo " ~I E.g. gbdel branch_name\n"
	else
			# Start deleteing.
			echo "\n⏳ Deleting…\n"
			git branch -D "$1" # Local delete.
			git push origin --delete "$1" # Remote delete.
			echo "\n✅ Git branch $1 was deleted from local and remote.\n"
	fi
}

# getSystem — print what type of machine you are on.
#
# Currently prints "This is a Mac machine" when `uname` is Darwin and
# "This is a Windows machine" for everything else. The Linux branch repeats
# the Darwin test, so it never matches and Linux falls through to Windows.
#
# Usage:
#   getSystem
##! Need to update this for windows response
##! MINGW64_NT and MINGW32_NT.
function getSystem () {
  if [[ "$(uname)" == "Darwin" ]]; then
    echo "This is a Mac machine";
  elif [[ "$(uname)" == "Darwin" ]]; then
    echo "This is a Linux machine"
  else
    echo "This is a Windows machine"
  fi
}

# dateF — print today's date in a common format, prefixed with 📅.
#
# Usage:
#   dateF <format> [-s | --separator <char>]
#
# Formats:
#   yyyymmdd   full year, month, day
#   mmddyyyy   month, day, full year
#   mmddyy     month, day, short year
#
# Options:
#   -s | --separator   character placed between the parts (default: none)
#
# Examples:
#   dateF mmddyyyy                    # 10072026
#   dateF mmddyy --separator "-"      # 10-07-26
#
# Running it with no or an unknown format prints this usage.
##! Add more formats and roll this
##! out to its own script.
function dateF() {
  separator=
  format=

  case $1 in
    yyyymmdd )
      case $2 in
        -s | --separator )
          separator=$3
          echo "📅 $(date +%Y${separator}%m${separator}%d)"
          ;;
        * )
          echo "📅 $(date +%Y${separator}%m${separator}%d)"
          ;;
      esac
      ;;
    mmddyyyy )
      case $2 in
        -s | --separator )
          separator=$3
          echo "📅 $(date +%m${separator}%d${separator}%Y)"
          ;;
        * )
          echo "📅 $(date +%m${separator}%d${separator}%Y)"
          ;;
      esac
      ;;
    mmddyy )
      case $2 in
        -s | --separator )
          separator=$3
          echo "📅 $(date +%m${separator}%d${separator}%y)"
          ;;
        * )
          echo "📅 $(date +%m${separator}%d${separator}%y)"
          ;;
      esac
      ;;
    * )
			echo -e "Usage: dateF <commands> [--option]"
      echo
      echo -e "Commands:"
      echo -e "  yyyymmdd            Shows fullYear month day"
      echo -e "  mmddyyyy            Shows month day fullYear"
      echo -e "  mmddyy              Shows month day shortYear"
      echo
      echo -e "Options:"
      echo -e "  -s | --separator    Adds a separator"
      echo
      echo -e "Example:"
      echo -e "  dateF mmddyyyy #10222023"
      echo -e "  dateF mmddyy --separator \"-\" #10-22-23"
      echo
			;;
  esac
}


#! Github Repo Add Token
# ghs — set a GitHub Actions secret on a repo, using the value of an
# environment variable of the same name from your current shell.
#
# Pipes the value of $<SECRET_NAME> into `gh secret set <SECRET_NAME>` for
# the repo <owner>/<repo-name>. The owner defaults to PaleBluDot.
#
# Usage:
#   ghs <SECRET_NAME> <repo-name> [owner]
#
# Example:
#   ghs NPM_TOKEN my-repo            # sets NPM_TOKEN on PaleBluDot/my-repo
#   ghs NPM_TOKEN my-repo some-org   # sets it on some-org/my-repo
#
# Requires: zsh (uses ${(P)1}), an authenticated `gh` CLI, and the variable
# already set in the current shell.
ghs() {
  echo ${(P)1} | gh secret set $1 --repo ${3:-PaleBluDot}/$2
}



#! Create ENV varibale
# setenv — set an environment variable for the current shell session only.
#
# Same as `export <VAR_NAME>=<value>`. It is gone when the shell closes.
#
# Usage:
#   setenv <VAR_NAME> <value>
#
# Example:
#   setenv GH_TOKEN abc123
setenv() {
  export $1=$2
}



# exit — override of the built-in `exit` that is safe to use inside tmux.
#
# Inside tmux it detaches from the session instead of closing it, so your
# session keeps running. Outside tmux it behaves like the normal `exit`.
#
# Usage:
#   exit
#
# Because this replaces the built-in, any function that calls `exit`
# (such as pushover and getHTTPCode) gets this behavior too. Use
# `builtin exit` to bypass the override.
exit() {
    if [ -n "$TMUX" ]; then
        tmux detach
    else
        builtin exit
    fi
}


# detach — detach from the current tmux session.
#
# Prints a message instead if you are not inside tmux.
#
# Usage:
#   detach
detach() {
    if [ -n "$TMUX" ]; then
        tmux detach
    else
        echo "Not in a tmux session — nothing to detach from."
    fi
}



# sysup — update all installed packages with the native package manager
# for the OS you are on.
#
# Detects the OS with `uname`, and on Linux reads ID / ID_LIKE from
# /etc/os-release to pick the package manager:
#   macOS            brew update && brew upgrade
#   Windows (Git Bash) winget upgrade --all
#   Arch-based       sudo pacman -Syu --noconfirm
#   Fedora-based     sudo dnf upgrade -y
#   Debian-based     sudo apt update && sudo apt upgrade -y
#
# Usage:
#   sysup
#
# Returns 1 with a message on stderr if the OS or distro is not recognized.
# Linux needs sudo; the -y / --noconfirm flags skip the confirmation prompt.
sysup() {
  local distro

  case "$(uname -s)" in
    Darwin)
      brew update && brew upgrade
      ;;
    MINGW* | MSYS*)
      winget upgrade --all --accept-package-agreements --accept-source-agreements
      ;;
    Linux)
      if [[ ! -f /etc/os-release ]]; then
        echo "sysup: /etc/os-release not found" >&2
        return 1
      fi

      # The ( ... ) subshell keeps ID, NAME, VERSION etc. from leaking into your live shell.
      distro=$( . /etc/os-release; echo "${ID:-} ${ID_LIKE:-}" )

      case " $distro " in
        *" arch "*)   sudo pacman -Syu --noconfirm ;;
        *" fedora "*) sudo dnf upgrade -y ;;
        *" debian "*) sudo apt update && sudo apt upgrade -y ;;
        *)
          echo "sysup: unsupported distro ($distro)" >&2
          return 1
          ;;
      esac
      ;;
    *)
      echo "sysup: unsupported OS ($(uname -s))" >&2
      return 1
      ;;
  esac
}