[init]
	defaultBranch = main
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[gpg]
	format = ssh
[commit]
	gpgsign = true
[tag]
	gpgsign = true
[core]
	excludesFile = ~/.config/git/ignore
# HTTPS logins to GitHub go through gh (what `gh auth setup-git` sets up).
# `gh` from PATH, not a full path: mise's install path changes with every gh
# version, and it differs per OS. The empty helper clears any helper set
# before this one.
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
[include]
	# Written by dotfiles (doctor / first run) for this machine's OS: 1Password's op-ssh-sign path. Not tracked.
	path = local.gitconfig
