[user]
	name = Pavel Sanchez
	email = 23495830+PaleBluDot@users.noreply.github.com
	# No signingkey here: each machine's public key is ~/.ssh/<hostname>.pub,
	# and 1Password signs with the matching private key.
[init]
	defaultBranch = main
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[gpg]
	format = ssh
[gpg "ssh"]
	# Used when user.signingkey is unset: sign with this machine's key, ~/.ssh/<hostname>.pub.
	defaultKeyCommand = sh -c 'echo key::$(cat ~/.ssh/$(hostname -s).pub)'
[commit]
	gpgsign = true
[tag]
	gpgsign = true
[core]
	excludesFile = ~/.config/git/.gitignore
[include]
	# Per-machine settings written by link.sh (1Password's op-ssh-sign path differs per OS). Not tracked.
	path = local.gitconfig
