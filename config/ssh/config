# Host entries 1Password generates (SSH bookmarks), if any.
Include ~/.ssh/1Password/config

# All keys live in 1Password; its agent approves every use. Agent path differs per OS.
Match exec "test \"$(uname)\" = Darwin"
    IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

Host *
    IdentityAgent ~/.1password/agent.sock
    # Each machine's public key is ~/.ssh/<hostname>.pub; %L is the short
    # hostname. Only that key is offered.
    IdentitiesOnly yes
    IdentityFile ~/.ssh/%L.pub
    SetEnv TERM=xterm-256color

# Network
Host pfsense
    HostName {{ op://lab/pfsense/hostname }}
    User {{ op://lab/pfsense/username }}


