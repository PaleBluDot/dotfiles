# shellcheck shell=bash
# Shared environment for zsh and bash. One file for both shells:
#   zsh  reads it through the ~/.zshenv link (every zsh, nested ones too)
#   bash reads it from ~/.bashrc (login shells get there through ~/.profile)
# Keep it in syntax that runs in both. zsh-only settings go in the
# "ZSH ONLY" block below, which bash skips.

# EDITOR
# Use nano over SSH, VS Code locally
# -----------------------
if [[ -n $SSH_CONNECTION ]]; then
  export EDITOR='nvim'
  export VISUAL='nvim'
else
  export EDITOR='nvim'
  # --wait: git commit waits for the file to be closed (config/shell/aliases falls back
  # to code when Insiders isn't installed).
  export VISUAL='code-insiders --wait'
fi

# CORE DIRECTORIES
# Paths needed before .zshrc loads
# -----------------------
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_STATE_HOME="$HOME/.local/state"
export XDG_CACHE_HOME="$HOME/.cache"

# zsh's config folder, exported so functions, scripts and bash can use it.
# (zsh itself reads ZDOTDIR, set in the ZSH ONLY block below.)
export ZSH_CONFIG_DIR="$XDG_CONFIG_HOME/zsh"

# DOTFILES: wherever this machine's repo is, found through the dotfiles
# command link that dotfiles.sh makes (~/.local/bin/dotfiles ->
# …/dotfiles/dotfiles.sh). A DOTFILES already set is kept, so a shell can be
# pointed at another checkout: DOTFILES=~/other/dotfiles zsh
_dotfiles_link="$HOME/.local/bin/dotfiles"
if [[ -z ${DOTFILES:-} && -L $_dotfiles_link ]]; then
  DOTFILES="$(cd "$(dirname "$(readlink -f "$_dotfiles_link")")" && pwd)"
fi
[[ -n ${DOTFILES:-} ]] && export DOTFILES
unset _dotfiles_link

# Colors for functions that print status lines (checkGit, checkAllRepos, …).
# Not exported: only this shell's functions use them.
LIGHTGREEN=$'\e[1;32m'
LIGHTRED=$'\e[1;31m'
NC=$'\e[0m'
# Starship: a copy of starship.toml with the current theme's palette picked
# (the theme hook writes the palette's name to ~/.cache/starship/palette).
# The copy is redone whenever starship.toml changes, so edits show at once.
# No palette file (theme never set here) = the repo file as is.
_starship_src="$HOME/.config/starship/starship.toml"
_starship_copy="$XDG_CACHE_HOME/starship/starship.toml"
if [[ -r $XDG_CACHE_HOME/starship/palette && -f $_starship_src ]]; then
  if [[ ! -f $_starship_copy || $_starship_src -nt $_starship_copy ]]; then
    sed "s/^palette = .*/palette = \"$(<$XDG_CACHE_HOME/starship/palette)\"/" "$_starship_src" >"$_starship_copy"
  fi
  export STARSHIP_CONFIG="$_starship_copy"
else
  export STARSHIP_CONFIG="$_starship_src"
fi
unset _starship_src _starship_copy
# Linux console (TTY): no Nerd Font there, so a plain-ASCII prompt instead.
# TERM is "linux" on the console itself; inside tmux it isn't, so ask tmux
# what terminal its client is on. Anywhere else, starship.toml (above).
if [[ $TERM == linux ]] ||
  [[ -n $TMUX && $(tmux display-message -p '#{client_termname}' 2>/dev/null) == linux ]]; then
  export STARSHIP_CONFIG="$HOME/.config/starship/tty.toml"
fi

# bat: the current theme's colours once the theme hook has installed them
# as bat's "omarchy" theme; otherwise --theme in bat's config (knuckles).
[[ -f $HOME/.config/bat/themes/omarchy.tmTheme ]] && export BAT_THEME="omarchy"

# LANGUAGE RUNTIMES
# Go and NVM directories
# -----------------------
# GOROOT only for a manual Go install (macOS); mise-managed Go sets its own,
# and a GOROOT pointing at a missing folder breaks it
[[ -d /usr/local/go ]] && export GOROOT=/usr/local/go
export GOPATH="$XDG_DATA_HOME/go"
export NVM_DIR="$HOME/.config/nvm"

# KEEP $HOME CLEAN
# Tools that would otherwise put caches and data straight into $HOME
# -----------------------
export npm_config_cache="$XDG_CACHE_HOME/npm"
export CARGO_HOME="$XDG_DATA_HOME/cargo"
export DOTNET_CLI_HOME="$XDG_DATA_HOME/dotnet"
export CUDA_CACHE_PATH="$XDG_CACHE_HOME/nv"
export GNUPGHOME="$XDG_DATA_HOME/gnupg"
export COMPOSER_CACHE_DIR="$XDG_CACHE_HOME/composer"
export DOCKER_CONFIG="$XDG_CONFIG_HOME/docker"
export WAKATIME_HOME="$XDG_CONFIG_HOME/wakatime"
export CLAUDE_CONFIG_DIR="$XDG_CONFIG_HOME/claude"
export PYTHON_HISTORY="$XDG_STATE_HOME/python_history"
export CODEX_HOME="$XDG_CONFIG_HOME/codex"
export NPM_CONFIG_INIT_MODULE="$XDG_CONFIG_HOME/npm/config/npm-init.js"
export NPM_CONFIG_TMP="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/npm"
export TLDR_CACHE_DIR="$XDG_CACHE_HOME/tldr"
export ATUIN_HOME="$XDG_DATA_HOME/atuin"
export ATUIN_CONFIG_DIR="$XDG_CONFIG_HOME/atuin"

# HISTORY SUPPRESSION
# Disable history for noisy tools
# -----------------------
export LESSHISTFILE=-
export NODE_REPL_HISTORY=""

# PAGER
# Neovim as manpager
# -----------------------
export MANPAGER="nvim +Man!"

# PATH
# -----------------------
export PATH="$DOTFILES/bin:$HOME/bin:$HOME/.config/npm/bin:$GOPATH/bin:${GOROOT:+$GOROOT/bin:}$HOME/.docker/bin:$PATH"
# ~/.local/bin goes last (as Omarchy does): it holds files like uv's `env`
# that must not shadow system commands
case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) export PATH="$PATH:$HOME/.local/bin" ;; esac

# ZSH ONLY
# Skipped by bash.
# -----------------------
if [[ -n ${ZSH_VERSION:-} ]]; then
  # Where zsh finds .zshrc and .zprofile. Not exported on purpose: a zsh
  # started from this one (tmux pane, nvim terminal, zsh -c) then starts with
  # it unset, reads ~/.zshenv again, and gets this whole file.
  ZDOTDIR="$ZSH_CONFIG_DIR"
  typeset +x ZDOTDIR

  export ZSH="$ZSH_CONFIG_DIR/oh-my-zsh"
  export ZSH_CACHE_DIR="$XDG_CACHE_HOME/oh-my-zsh"

  # macOS: no per-window session history files
  SHELL_SESSIONS_DISABLE=1

  # Completion cache: out of ~/.config/zsh and into the cache folder
  [[ -d $XDG_CACHE_HOME/zsh ]] || mkdir -p "$XDG_CACHE_HOME/zsh"
  export ZSH_COMPDUMP="$XDG_CACHE_HOME/zsh/.zcompdump-$HOST"
fi
