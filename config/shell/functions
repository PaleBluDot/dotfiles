# edit — open a config you edit often by name, e.g. `edit starship`, `edit nvim`.
#
# Folders (nvim, hypr, yazi) open with the editor started inside them, so
# LazyVim treats the folder as the project. Tab completes the names.
# Anything that isn't a known name is opened as a normal file path.
#
# Usage:
#   edit              # open $EDITOR
#   edit starship     # ~/.config/starship/starship.toml
#   edit list         # show every name and where it points
#   edit notes.md     # any other file, like before
#
# Add a target: put a "name  path" line in _edit_targets below.
_edit_targets=(
  aliases    "$DOTFILES/config/shell/aliases"
  functions  "$DOTFILES/config/shell/functions"
  zshrc      "$DOTFILES/config/zsh/zshrc"
  env        "$DOTFILES/config/shell/env"
  starship   "$HOME/.config/starship/starship.toml"
  nvim       "$HOME/.config/nvim"
  hypr       "$HOME/.config/hypr"
  bindings   "$HOME/.config/hypr/bindings.lua"
  monitors   "$HOME/.config/hypr/monitors.lua"
  ghostty    "$HOME/.config/ghostty/config.ghostty"
  git        "$HOME/.config/git/config"
  ssh        "$DOTFILES/config/ssh/config"
  tmux       "$HOME/.config/tmux/tmux.conf"
  yazi       "$HOME/.config/yazi"
  lazygit    "$HOME/.config/lazygit/config.yml"
  fastfetch  "$HOME/.config/fastfetch/config.jsonc"
  shell      "$HOME/.config/omarchy/shell.toml"
  branding   "$HOME/.config/omarchy/branding/settings.toml"
)

# drop the old `alias edit=$EDITOR` if this shell still has it (reload keeps old aliases)
unalias edit 2>/dev/null
# _edit_target <name> — print the path for a name in _edit_targets (exit 1 if unknown).
_edit_target() {
  local name= item
  for item in "${_edit_targets[@]}"; do
    if [[ -z $name ]]; then name=$item; continue; fi
    [[ $name == "$1" ]] && { printf '%s\n' "$item"; return 0; }
    name=
  done
  return 1
}

# _edit_names — print every name in _edit_targets, one per line.
_edit_names() {
  local name= item
  for item in "${_edit_targets[@]}"; do
    if [[ -z $name ]]; then name=$item; printf '%s\n' "$name"; else name=; fi
  done
}

function edit() {
  local target name shown
  if (( $# == 0 )); then
    command $EDITOR
  elif [[ $1 == list ]]; then
    for name in $(_edit_names | LC_ALL=C sort); do
      shown=$(_edit_target "$name")
      [[ $shown == "$HOME"* ]] && shown="~${shown#"$HOME"}"
      printf '%-10s %s\n' "$name" "$shown"
    done
  elif target=$(_edit_target "$1"); then
    if [[ -d $target ]]; then
      (builtin cd "$target" && command $EDITOR .)
    else
      command $EDITOR "$target"
    fi
  else
    command $EDITOR "$@"
  fi
}

# Tab completion: the names above (plus list), then normal file names.
if [[ -n $ZSH_VERSION ]]; then
  _edit() {
    _alternative "names:config:(list $(_edit_names | tr '\n' ' '))" 'files:file:_files'
  }
  whence -w compdef >/dev/null 2>&1 && compdef _edit edit
elif [[ -n $BASH_VERSION ]]; then
  _edit_complete() {
    COMPREPLY=($(compgen -W "list $(_edit_names)" -- "${COMP_WORDS[COMP_CWORD]}"))
  }
  complete -o bashdefault -o default -F _edit_complete edit
fi

# getURLParams — break a long URL down so it is easy to read: protocol, domain
# and slug on their own lines, then every query parameter, one per line, in
# alphabetical order. Names and values are printed exactly as they are in the
# URL (nothing is decoded, so %20 and friends stay visible). A parameter with
# no value, like af=, is listed with a blank value. A #fragment, if the URL has
# one, is printed last.
#
# The URL comes from the argument, from stdin, or from the clipboard when
# neither is given. Whitespace and line breaks inside the URL are removed first,
# so a URL wrapped over several lines still works.
#
# Usage:
#   getURLParams 'https://example.com/a?x=1&y=2'   # quote it, the shell treats & as special
#   getURLParams                                   # read the URL from the clipboard
#   wl-paste | getURLParams                        # or pipe it in
#
# Clipboard: wl-paste (Wayland), xclip (X11) or pbpaste (macOS), whichever exists.
# Colors are only used when printing to a terminal.
function getURLParams() {
  local url
  if (( $# )); then
    url="$*"
  elif [[ ! -t 0 ]]; then
    url=$(cat)
  elif command -v wl-paste >/dev/null 2>&1; then
    url=$(wl-paste --no-newline 2>/dev/null)
  elif command -v xclip >/dev/null 2>&1; then
    url=$(xclip -o -selection clipboard 2>/dev/null)
  elif command -v pbpaste >/dev/null 2>&1; then
    url=$(pbpaste)
  fi
  url=${url//[[:space:]]/}
  if [[ -z $url ]]; then
    echo "Usage: getURLParams '<url>'   (or copy a URL and run getURLParams)" >&2
    return 1
  fi

  local label=$'\e[2m' key=$'\e[36m' bold=$'\e[1m' reset=$'\e[0m'
  [[ -t 1 ]] || { label= key= bold= reset=; }

  # Split off #fragment and ?query, then protocol://domain/slug.
  local base=$url query= fragment=
  if [[ $base == *'#'* ]]; then fragment=${base#*'#'}; base=${base%%'#'*}; fi
  if [[ $base == *'?'* ]]; then query=${base#*'?'}; base=${base%%'?'*}; fi

  local protocol= domain= slug=$base
  if [[ $base == *://* ]]; then
    protocol=${base%%://*}
    domain=${base#*://}
    if [[ $domain == */* ]]; then slug=/${domain#*/}; domain=${domain%%/*}; else slug=/; fi
  fi

  [[ -n $protocol ]] && printf '%sprotocol%s  %s\n' "$label" "$reset" "$protocol"
  [[ -n $domain ]]   && printf '%sdomain%s    %s%s%s\n' "$label" "$reset" "$bold" "$domain" "$reset"
  printf '%sslug%s      %s\n' "$label" "$reset" "$slug"

  if [[ -n $query ]]; then
    # One name=value per line, empty pieces (from && or a trailing &) dropped,
    # sorted by name; -s keeps a repeated name in URL order.
    local pairs= rest=$query pair
    while [[ -n $rest ]]; do
      pair=${rest%%&*}
      if [[ $rest == *'&'* ]]; then rest=${rest#*&}; else rest=; fi
      [[ -n $pair ]] && pairs+="$pair"$'\n'
    done
    pairs=$(printf '%s' "$pairs" | LC_ALL=C sort -f -s -t '=' -k 1,1)

    local width=0 name
    while IFS= read -r pair; do
      name=${pair%%=*}
      (( ${#name} > width )) && width=${#name}
    done <<< "$pairs"

    echo
    while IFS= read -r pair; do
      [[ -z $pair ]] && continue
      name=${pair%%=*}
      if [[ $pair == *=* ]]; then
        printf '  %s%-*s%s  %s\n' "$key" "$width" "$name" "$reset" "${pair#*=}"
      else
        printf '  %s%s%s\n' "$key" "$name" "$reset"
      fi
    done <<< "$pairs"
  fi

  [[ -n $fragment ]] && printf '\n%sfragment%s  %s\n' "$label" "$reset" "$fragment"
  return 0
}
