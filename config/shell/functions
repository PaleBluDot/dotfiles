# dateF — print today's date in a common format, prefixed with 📅.
#
# Usage:
#   dateF <format> [-s | --separator <char>]
#
# Formats:
#   yyyymmdd   full year, month, day
#   mmddyyyy   month, day, full year
#   mmddyy     month, day, short year
#
# Options:
#   -s | --separator   character placed between the parts (default: none)
#
# Examples:
#   dateF mmddyyyy                    # 10072026
#   dateF mmddyy --separator "-"      # 10-07-26
#
# Running it with no or an unknown format prints this usage.
##! Add more formats and roll this
##! out to its own script.
function dateF() {
  separator=
  format=

  case $1 in
    yyyymmdd )
      case $2 in
        -s | --separator )
          separator=$3
          echo "📅 $(date +%Y${separator}%m${separator}%d)"
          ;;
        * )
          echo "📅 $(date +%Y${separator}%m${separator}%d)"
          ;;
      esac
      ;;
    mmddyyyy )
      case $2 in
        -s | --separator )
          separator=$3
          echo "📅 $(date +%m${separator}%d${separator}%Y)"
          ;;
        * )
          echo "📅 $(date +%m${separator}%d${separator}%Y)"
          ;;
      esac
      ;;
    mmddyy )
      case $2 in
        -s | --separator )
          separator=$3
          echo "📅 $(date +%m${separator}%d${separator}%y)"
          ;;
        * )
          echo "📅 $(date +%m${separator}%d${separator}%y)"
          ;;
      esac
      ;;
    * )
			echo -e "Usage: dateF <commands> [--option]"
      echo
      echo -e "Commands:"
      echo -e "  yyyymmdd            Shows fullYear month day"
      echo -e "  mmddyyyy            Shows month day fullYear"
      echo -e "  mmddyy              Shows month day shortYear"
      echo
      echo -e "Options:"
      echo -e "  -s | --separator    Adds a separator"
      echo
      echo -e "Example:"
      echo -e "  dateF mmddyyyy #10222023"
      echo -e "  dateF mmddyy --separator \"-\" #10-22-23"
      echo
			;;
  esac
}


#! Github Repo Add Token
# ghs — set a GitHub Actions secret on a repo, using the value of an
# environment variable of the same name from your current shell.
#
# Pipes the value of $<SECRET_NAME> into `gh secret set <SECRET_NAME>` for
# the repo <owner>/<repo-name>. The owner defaults to PaleBluDot.
#
# Usage:
#   ghs <SECRET_NAME> <repo-name> [owner]
#
# Example:
#   ghs NPM_TOKEN my-repo            # sets NPM_TOKEN on PaleBluDot/my-repo
#   ghs NPM_TOKEN my-repo some-org   # sets it on some-org/my-repo
#
# Requires: an authenticated `gh` CLI, and the variable already set in the
# current shell.
ghs() {
  if [[ ! $1 =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
    echo "ghs: not a variable name: $1" >&2
    return 1
  fi
  local value
  eval "value=\${$1}"
  printf '%s\n' "$value" | gh secret set "$1" --repo "${3:-PaleBluDot}/$2"
}



