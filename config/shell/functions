# exit — override of the built-in `exit` that is safe to use inside tmux.
#
# Inside tmux it detaches from the session instead of closing it, so your
# session keeps running. Outside tmux it behaves like the normal `exit`.
#
# Usage:
#   exit
#
# Because this replaces the built-in, any function that calls `exit`
# (such as pushover and getHTTPCode) gets this behavior too. Use
# `builtin exit` to bypass the override.
exit() {
    if [ -n "$TMUX" ]; then
        tmux detach
    else
        builtin exit
    fi
}


# detach — detach from the current tmux session.
#
# Prints a message instead if you are not inside tmux.
#
# Usage:
#   detach
detach() {
    if [ -n "$TMUX" ]; then
        tmux detach
    else
        echo "Not in a tmux session — nothing to detach from."
    fi
}



# sysup — update all installed packages with the native package manager
# for the OS you are on.
#
# Uses $OS_DISTRO and $OS_PKG, which .zshrc sets from osinfo when the terminal
# starts, to pick the update command. Omarchy is checked first because it has
# its own updater, which must be used instead of a plain pacman upgrade:
#   omarchy  omarchy update -y
#   brew     brew update && brew upgrade
#   winget   winget upgrade --all
#   pacman   sudo pacman -Syu --noconfirm
#   dnf      sudo dnf upgrade -y
#   apt      sudo apt update && sudo apt upgrade -y
#
# Usage:
#   sysup
#
# Returns 1 with a message on stderr if $OS_PKG is unset or not supported.
# Linux needs sudo; the -y / --noconfirm flags skip the confirmation prompt.
sysup() {
  if [[ ${OS_DISTRO:-} == omarchy ]]; then
    omarchy update -y
    return
  fi

  case "${OS_PKG:-}" in
    brew)   brew update && brew upgrade ;;
    winget) winget upgrade --all --accept-package-agreements --accept-source-agreements ;;
    pacman) sudo pacman -Syu --noconfirm ;;
    dnf)    sudo dnf upgrade -y ;;
    apt)    sudo apt update && sudo apt upgrade -y ;;
    "")
      echo "sysup: OS_PKG is not set; open a new terminal or run reload" >&2
      return 1
      ;;
    *)
      echo "sysup: unsupported package manager: $OS_PKG" >&2
      return 1
      ;;
  esac
}
# zd — smarter cd (Omarchy's bash function, for bash and zsh). `cd` is aliased to it in aliases.
#
# No argument goes home, a real directory is entered normally, anything else is
# looked up with zoxide (`z`) and the directory it jumped to is printed.
#
# Usage:
#   zd            # ~
#   zd ~/Projects # normal cd
#   zd dot        # zoxide jump to the best "dot" match
#
# Requires: zoxide (initialised in .zshrc). Without it, falls back to plain cd.
zd() {
  if (( $# == 0 )); then
    builtin cd ~ || return
  elif [[ -d $1 ]] || ! type z >/dev/null 2>&1; then
    builtin cd "$@" || return
  else
    if ! z "$@"; then
      echo "Error: Directory not found"
      return 1
    fi
    printf "\U000F17A9 "
    pwd
  fi
}

# n — open nvim: the current folder with no argument, otherwise the given files
