#!/bin/bash
# Omarchy theme-set hook (also run by bin/theme-set on machines without
# Omarchy, after it renders the templates): point starship, bat, superfile
# and tmux at the new theme, rebuild the VS Code themes. $1 = the theme's
# slug (sonic-night).
#
# The templates are already rendered into ~/.local/state/omarchy/current/theme/
# when this runs. DOTFILES_THEME_NO_RELOAD=1 (theme-set --no-reload) leaves a
# running tmux alone.

theme="${1:-}"
THEME_DIR="$HOME/.local/state/omarchy/current/theme"
COLORS="$THEME_DIR/colors.toml"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}"

# One colour from colors.toml: key = "#rrggbb".
color() {
  awk -F'"' -v key="$1" '$0 ~ "^" key "[[:space:]]*=" { print $2; exit }' "$COLORS"
}

# ─── extra templates ─────────────────────────────────────────────────────
# After omarchy-theme-set: render the templates Omarchy doesn't ship (bat,
# tmux, ...) for the tools installed here (config/theme/tools). bin/theme-set
# sets DOTFILES_THEME_SET=1 when it runs this hook: it rendered them already.
# The repo is four folders up from this file's real location.
if [[ ${DOTFILES_THEME_SET:-} != 1 ]]; then
  hook_dir="$(cd "$(dirname "$0")" && pwd -P)"
  setter="$hook_dir/../../../../bin/theme-set"
  if [[ -f $setter ]]; then
    bash "$setter" --extras --quiet || true
  fi
fi

# ─── starship ────────────────────────────────────────────────────────────
# ~/.config/starship/starship.toml (the repo file, through the link) has one
# [palettes.<theme>] per theme. A theme without one gets it here, built from
# its colors.toml (a repo change to commit). starship reads a copy with
# palette = "<theme>"; .zshenv redoes the copy when starship.toml changes.
starship_src="$HOME/.config/starship/starship.toml"
if [[ -n $theme && -f $starship_src ]]; then
  if [[ -f $COLORS ]] && ! grep -q "^\[palettes\.$theme\]" "$starship_src"; then
    {
      printf '\n[palettes.%s]\n' "$theme"
      printf 'os = "%s"\n' "$(color accent)"
      printf 'os_text = "%s"\n' "$(color background)"
      printf 'user = "%s"\n' "$(color blue)"
      printf 'directory = "%s"\n' "$(color magenta)"
      printf 'git = "%s"\n' "$(color red)"
      printf 'language = "%s"\n' "$(color green)"
      printf 'docker = "%s"\n' "$(color cyan)"
      printf 'time = "%s"\n' "$(color bright_blue)"
      printf 'root = "%s"\n' "$(color orange)"
    } >>"$starship_src"
  fi
  palette="starburst"
  if grep -q "^\[palettes\.$theme\]" "$starship_src"; then
    palette="$theme"
  fi
  mkdir -p "$CACHE/starship"
  printf '%s\n' "$palette" >"$CACHE/starship/palette"
  sed "s/^palette = .*/palette = \"$palette\"/" "$starship_src" >"$CACHE/starship/starship.toml"
fi

# ─── bat ─────────────────────────────────────────────────────────────────
# bat only reads themes from its own themes folder, after a cache rebuild.
# The rendered theme is copied in as "omarchy" (gitignored in the repo).
bat_cmd="$(command -v bat || command -v batcat)"
if [[ -n $bat_cmd && -f $THEME_DIR/bat.tmTheme ]]; then
  bat_themes="$("$bat_cmd" --config-dir)/themes"
  mkdir -p "$bat_themes"
  cp "$THEME_DIR/bat.tmTheme" "$bat_themes/omarchy.tmTheme"
  "$bat_cmd" cache --build >/dev/null 2>&1 || true
fi

# ─── superfile ───────────────────────────────────────────────────────────
# superfile only loads themes by name from its theme folder. A link there
# points at the rendered file, so later theme changes need nothing else
# (gitignored in the repo; a missing target = its built-in default).
spf_themes="$HOME/.config/superfile/theme"
if [[ -d $HOME/.config/superfile && -f $THEME_DIR/superfile.toml ]]; then
  mkdir -p "$spf_themes"
  ln -sfn "$THEME_DIR/superfile.toml" "$spf_themes/omarchy.toml"
fi

# ─── VS Code ─────────────────────────────────────────────────────────────
# Rebuilds the local.dotfiles-themes extension when a theme's colours
# changed (a no-op otherwise). Omarchy's own VS Code step ran before this
# hook and already set workbench.colorTheme from the theme's vscode.json.
vscode_hook="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)/../../../dotfiles/hooks/vscode.sh"
if [[ -f $vscode_hook ]]; then
  bash "$vscode_hook" >/dev/null 2>&1 || true
fi

# ─── tmux ────────────────────────────────────────────────────────────────
# A running tmux re-reads its config, which sources the rendered tmux.conf.
if [[ ${DOTFILES_THEME_NO_RELOAD:-} != 1 ]] && command -v tmux >/dev/null 2>&1 && tmux list-sessions >/dev/null 2>&1; then
  tmux source-file "$HOME/.config/tmux/tmux.conf" >/dev/null 2>&1 || true
fi
