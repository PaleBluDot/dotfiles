# starship palette for the current theme: the keys starship.toml's layout
# uses. The theme hook appends this as [palettes.<theme>] when a theme has none.
os = "{{ accent }}"
os_text = "{{ background }}"
user = "{{ blue }}"
directory = "{{ magenta }}"
git = "{{ red }}"
language = "{{ green }}"
docker = "{{ cyan }}"
time = "{{ bright_blue }}"
root = "{{ orange }}"
