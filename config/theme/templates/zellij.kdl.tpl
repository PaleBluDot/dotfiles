// zellij theme: copy to ~/.config/zellij/themes/omarchy.kdl and set
// theme "omarchy" in config.kdl.
themes {
    omarchy {
        fg "{{ foreground }}"
        bg "{{ background }}"
        black "{{ background }}"
        red "{{ red }}"
        green "{{ green }}"
        yellow "{{ yellow }}"
        blue "{{ blue }}"
        magenta "{{ magenta }}"
        cyan "{{ cyan }}"
        white "{{ foreground }}"
        orange "{{ orange }}"
    }
}
