cursor = "{{ bright_foreground }}"
correct = "{{ green }}"
error = "{{ red }}"
hint = "{{ cyan }}"
cancel = "{{ dark_foreground }}"
gradient_color = ["{{ blue }}", "{{ magenta }}"]

file_panel_top_directory_icon = "{{ green }}"
