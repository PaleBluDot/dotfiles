#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# No commits on main: changes go through a feat/fix branch, then dev, then a
# pull request into main. CI is let through, because semantic-release commits
# the release on main there.
if [ -n "${CI:-}" ]; then
  exit 0
fi
if [ "$(git symbolic-ref --short HEAD 2>/dev/null)" = "main" ]; then
  echo "pre-commit: no commits on main; make a branch from dev first:" >&2
  echo "  git switch -c feat/<topic> origin/dev" >&2
  exit 1
fi
